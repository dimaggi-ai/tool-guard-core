# Build artifacts
/bin/
/cache/

# Test artifacts
coverage.out
coverage.html
*.prof
*.cover
*.test

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local-only convenience
.env
.envrc

# Generated by example runs — the committed fixtures are
# examples/decisions_chain.jsonl and docs/battle-test-run.json
examples/*/decisions.jsonl
examples/*/decisions.jsonl.*
examples/*/*.log
examples/postgres-attack/audit/

# Stray root-level build outputs (binaries belong in /bin)
/tg
/tg-proxy
/mcp-server
/battle-test
/example-chain

# Python (sdk/python/) — none of this existed before the SDK landed, so
# nothing caught it: `git add sdk/` would have committed venvs, bytecode,
# and coverage artifacts straight into the public repo.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
.venv/
*.venv/
