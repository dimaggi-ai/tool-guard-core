{
  "name": "secret_commands_shadow_deny_config_password_flag",
  "description": "A --password=value written into an agent config file is recorded as a deny. The policy is shadow mode, so the call runs. The value is synthetic.",
  "policy_file": "../../policies/coding_agent_secret_commands.yaml",
  "mode": "enforcement",
  "envelope": {
    "tool_name": "write",
    "tool_group": "filesystem_writes",
    "parameters": {
      "file_path": ".claude/settings.local.json",
      "content": "{\"permissions\": {\"allow\": [\"Bash(mysql --password=SYNTH-pw appdb)\"]}}"
    }
  },
  "expect": {
    "decision": "denied",
    "action_taken": "allowed_shadow",
    "matched_rule_ids": [
      "rule-secret-in-agent-config"
    ]
  }
}
