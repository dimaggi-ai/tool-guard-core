{
  "name": "secret_commands_shadow_escalate_note_query_key",
  "description": "An api_key in a query string copied into a note is recorded as an escalation. The policy is shadow mode, so the call runs. The value is synthetic.",
  "policy_file": "../../policies/coding_agent_secret_commands.yaml",
  "mode": "enforcement",
  "envelope": {
    "tool_name": "edit",
    "tool_group": "filesystem_writes",
    "parameters": {
      "file_path": "NOTES.md",
      "old_string": "endpoint",
      "new_string": "endpoint https://api.example.com/v1?api_key=SYNTHqk0123456789"
    }
  },
  "expect": {
    "decision": "escalated",
    "action_taken": "allowed_shadow",
    "matched_rule_ids": [
      "rule-secret-in-agent-note"
    ]
  }
}
