{
  "name": "codex_bash_shell",
  "description": "Codex CLI dispatches the same PreToolUse envelope as Claude Code; captured from codex exec.",
  "harness": "codex-cli",
  "harness_version": "0.166.0",
  "capture": {
    "captured_from": "real install",
    "captured_on": "2026-11-09",
    "sanitisation": "session ids, transcript paths, model names and tool_use ids replaced with cap-* placeholders; tool names and parameter names and their casing are exactly as emitted"
  },
  "payload": {
    "session_id": "cap-session",
    "turn_id": "cap-turn",
    "transcript_path": "/cap/rollout.jsonl",
    "cwd": "/cap",
    "hook_event_name": "PreToolUse",
    "model": "cap-model",
    "permission_mode": "bypassPermissions",
    "tool_name": "Bash",
    "tool_input": {
      "command": "echo probe"
    },
    "tool_use_id": "cap-exec"
  },
  "hook_args": [
    "-policy-dir",
    "POLICIES",
    "-mode",
    "enforcement",
    "-fail-closed-tools",
    "bash,powershell,write,edit,notebookedit"
  ],
  "expect": {
    "decision": "allow",
    "cites": ""
  }
}
