{
  "name": "protectpath_agy_redirect",
  "description": "A redirection at a -protect-path target is denied whatever harness dialect carried it.",
  "harness": "antigravity-cli",
  "harness_version": "1.5.3",
  "capture": {
    "captured_from": "captured shape",
    "captured_on": "2026-11-09",
    "sanitisation": "built from the parameter names and casing of a real capture of this harness; no session metadata"
  },
  "payload": {
    "artifactDirectoryPath": "/cap/brain",
    "conversationId": "cap-conv",
    "lastUserInput": "capture probe",
    "modelName": "cap-model",
    "stepIdx": 2,
    "toolCall": {
      "name": "run_command",
      "args": {
        "CommandLine": "echo x > /cap/protected/settings.json",
        "WaitMsBeforeAsync": 5000
      }
    },
    "transcriptPath": "/cap/transcript.jsonl",
    "workspacePaths": [
      "/cap"
    ]
  },
  "hook_args": [
    "-policy-dir",
    "POLICIES",
    "-mode",
    "enforcement",
    "-protect-path",
    "/cap/protected/settings.json"
  ],
  "expect": {
    "decision": "deny",
    "cites": "protected path"
  },
  "output_dialect": "antigravity"
}
